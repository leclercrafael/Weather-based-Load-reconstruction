# =================================================================
# Large artifacts: everything below is either auto-downloaded by the
# notebooks or regenerated by running them. Nothing here is an input
# you cannot get back. See README for what to re-run.
# =================================================================

# Trained models (regenerated by the residential/commercial notebooks)
models/
models_comstock/
models_temporal/
models_weather_fixed/
models_feature_engineered/
models_lightgbm_final/
models_xgboost_final/
statewide/models/

# NREL ResStock/ComStock archetype profiles + AMY weather (auto-downloaded from S3)
statewide/comstock_raw/
statewide/weather_by_county/
weather_county_fixed/
statewide/spatial_tract_lookup_table.csv

# 8760 x N bus-level reconstructions (regenerated; ~1.9 GB)
statewide/exports/*_8760_*.csv
loadcurves/exports/*_8760*.csv

# Bulk downloads cached under loadcurves/exports (NREL archetypes, ZBP, census)
loadcurves/exports/up0-*.csv
loadcurves/exports/up00-*.csv
loadcurves/exports/*zbp*.csv
loadcurves/exports/census_b25024_state_48_tracts.csv

# TIGER/Line shapefiles (downloadable from census.gov) — but keep the small
# hand-exported COAST attribute tables, which are manual inputs.
loadcurves/exports/tl_*.zip
loadcurves/exports/tl_*/
!loadcurves/exports/tl_2018_48_puma10_COAST.csv
!loadcurves/exports/tl_2018_us_zcta510_COAST_centwithin.csv

# ArcGIS scratch / project binaries
ClimateZones/
loadcurves/loadcurves.gdb/
loadcurves/Index/
loadcurves/GpMessages/
loadcurves/ImportLog/
*.aprx
*.atbx

# ------------------------------------------------------------------
# Raw subdivided ArcGIS exports: NOT regenerable from code, but too
# large for GitHub (118 MB / 53 MB; the hard limit is 100 MB).
# The information they carry is committed in aggregated form as
# statewide/tract_bus_weights.csv and statewide/zcta_bus_weights.csv
# (weight = parts won / total parts). Keep the raw files backed up
# outside git; see README.
# ------------------------------------------------------------------
tract_to_bus_mapping_statewide1.csv
zcta_to_bus_mapping_statewide_tracts_subdivided100.csv

# LaTeX build artifacts (report.pdf itself is committed)
latex_report/*.aux
latex_report/*.log
latex_report/*.out
latex_report/*.toc
latex_report/*.lof
latex_report/*.lot
latex_report/*.synctex.gz
